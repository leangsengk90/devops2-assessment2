# Local .terraform directories
**/.terraform/*

# .tfstate files
# *.tfstate
# *.tfstate.*

# Exclude all .tfvars files, which are likely to contain sensitive data
# *.tfvars
# *.tfvars.json

# Include override files you do wish to add to version control using negated pattern
# !example_override.tf

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Ignore plan files
*.plan
plans/

# Ignore lock files (optional - some teams commit this)
.terraform.lock.hcl
# Added by code-review-graph
.code-review-graph/

# macOS
.DS_Store

# Local AI tooling (code-review-graph / Claude Code)
.claude/
.mcp.json
CLAUDE.md

# Rebuild-timing run artifacts (state copies, raw logs, pid)
reports/**/state/
reports/**/logs/
reports/**/run.pid

__pycache__/
